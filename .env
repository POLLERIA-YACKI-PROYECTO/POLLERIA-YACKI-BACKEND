# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=admin
DB_NAME=polleria_yacki
DB_PORT=3306

# JWT
JWT_SECRET=polleria-yacky-secret-key-2026
JWT_EXPIRES_IN=7d

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=Polleria Yacky API
SWAGGER_DESCRIPTION=API para el sistema de gestión de Polleria Yacky
SWAGGER_VERSION=1.0.0
SWAGGER_CONTACT_EMAIL=contacto@polleriayacky.com